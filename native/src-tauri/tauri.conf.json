{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tempo",
  "version": "0.1.0",
  "identifier": "io.github.bgage72590.tempo",
  "build": {
    "frontendDist": "../../dist-native"
  },
  "app": {
    "windows": [
      {
        "title": "Tempo Chess Gym",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "Chess training: lessons, puzzles, openings, endgames and games against Stockfish.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
