{
  "name": "tempo-chess-training",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tempo: an interactive chess training system - lessons, tactics, openings, endgames, board vision and coached games.",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc -b && vite build",
    "build:single": "node scripts/copy-engine.mjs && tsc -b && vite build --mode single && node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "puzzles:generate": "tsx scripts/puzzles/generate.ts",
    "puzzles:build": "tsx scripts/puzzles/build.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "stockfish": "^19.0.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
